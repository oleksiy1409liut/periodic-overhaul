name: Steam Turbine
description: Uses the flow of hot steam in a pressurized chamber to spin a magnet and generate small amounts of energy.
type: ConsumeGenerator
health: 250
size: 3
hasPower: true
hasLiquids: true
liquidCapacity: 600
powerProduction: 1.8
itemDuration: 60
outputLiquid: water/0.02
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      drawLiquid: steam
      padding: 3
    }
    {
      type: DrawDefault
    }
    {
      type: DrawRegion
      suffix: -spinner
      spinSprite: true
      rotateSpeed: 7.5
    }
]
}

consumes: {
liquids: [
  steam/0.55
]
}
category: power
research: steam-boiler
requirements: [
steel-plate/35
bronze-plate/20
copper-coil/5
iron-plate/40
steel-magnet/2
]
