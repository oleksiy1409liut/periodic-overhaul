# Mandatory, defines the block as a multicrafter
type: MultiCrafter

# You can define any block variable below, as long as it is supported by the game.
name: "Advanced Furnace"
description: "A bigger and better fueled furnace, uses air flow to increase temperature to allow better recipes."
size: 4
itemCapacity: 100
liquidcapacity: 160
health: 350

  drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      drawLiquid: air-gas
      padding: 3
      alpha: 1
    }
    {
      type: DrawRegion
      suffix: -spinner
      y: 9.75
      x: -9.75
      spinSprite: true
      rotateSpeed: 2.5
    }
    {
      type: DrawDefault
    }
    {
      type: DrawGlowRegion
      suffix: -glow
      color: ffa665
      alpha: 1.2
      glowScale: 6
    }
  ]
}

# The library specific variables
jsonRecipes: [
    {
        name: copper-from-powder
        input: {
            items: ["periodic-copper-powder/6", "coal/2"]
            liquids: ["periodic-air-gas/0.3"]
        }
        output: {
            items: ["copper/5", "periodic-small-ash/1"]
        }
        craftTime: 150  # = 2.5 second
        unlocked: true
    }
    {
        name: zinc-from-powder
        input: {
            items: ["periodic-zinc-powder/6", "coal/2"]
            liquids: ["periodic-air-gas/0.3"]
        }
        output: {
            items: ["periodic-zinc-ingot/3", "periodic-small-ash/1"]
        }
        craftTime: 180  # = 3 seconds

        # This recipe will be unlocked and the player unlocks this research
        unlocked: true
    }
    {
        name: metaglass-from-sand
        input: {
            items: ["sand/6", "coal/2"]
            liquids: ["periodic-air-gas/0.45"]
        }
        output: {
            items: ["metaglass/3", "periodic-small-ash/1"]
        }
        craftTime: 150  # = 2.5 second
        unlocked: true
    }
    {
        name: steel-plate
        input: {
            items: ["periodic-iron-plate/4", "coal/4"]
            liquids: ["periodic-air-gas/0.3"]
        }
        output: {
            items: ["periodic-steel-plate/2", "periodic-small-ash/2"]
        }
        craftTime: 180  # = 3 second
        unlocked: true
    }
    {
        name: molybdate-from-molybdenite
        input: {
            items: ["periodic-purified-molybdenite/4", "coal/3"]
            liquids: ["periodic-air-gas/0.45", "water/0.1"]
        }
        output: {
            items: ["periodic-molybdate/3", "sand/1", "periodic-small-ash/1"]
            liquids: [periodic-sulfur-dioxide/0.1]
        }
        craftTime: 180  # = 3 seconds

        # This recipe will be unlocked and the player unlocks this research
        unlocked: true
    }
    {
        name: molybdenum-from-powder
        input: {
            items: ["periodic-molybdenum-powder/6", "coal/2"]
            liquids: ["periodic-air-gas/0.3"]
        }
        output: {
            items: ["periodic-molybdenum-plate/4", "periodic-small-ash/1"]
        }
        craftTime: 180  # = 3 seconds

        # This recipe will be unlocked and the player unlocks this research
        unlocked: true
    }
    {
        name: ferrite-core
        input: {
            items: ["periodic-zinc-oxide/6", "periodic-iron-oxide/4", "coal/2"]
            liquids: ["periodic-air-gas/0.3"]
        }
        output: {
            items: ["periodic-ferrite-core/2", "periodic-small-ash/1"]
        }
        craftTime: 240  # = 4 seconds

        # This recipe will be unlocked and the player unlocks this research
        unlocked: true
    }
]

# Back to the default game variables
requirements: ["stone/25", "iron-plate/15", "copper/15"]
category: "crafting"
