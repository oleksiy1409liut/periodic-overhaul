        }
        output: {
            items: ["periodic-aluminium-capacitor/1"]
        }
        craftTime: 60  # = 2 seconds

        # This recipe will be unlocked and the player unlocks this research
        unlocked: true
    }
    {
        name: circuit-power-supply
        input: {
            items: ["periodic-steel-plate/2", "periodic-ferrite-core/1", "periodic-ceramic/2", "periodic-copper-coil/1", "copper/1", "periodic-zinc-ingot/1"]
            liquids: ["periodic-steam/0.15"]
        }
        output: {
            items: ["periodic-circuit-power-supply/1"]
        }
