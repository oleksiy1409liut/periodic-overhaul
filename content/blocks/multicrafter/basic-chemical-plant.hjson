        }
        output: {
            items: ["periodic-aluminium-oxide/8"]
            liquids: []
        }
        craftTime: 540  # = 9 seconds
        unlocked: true
    }
    {
        name: hydrogen1
        input: {
            items: ["iron-plate/3"]
            liquids: ["periodic-steam/0.1", "periodic-air-gas/0.3"]
        }
