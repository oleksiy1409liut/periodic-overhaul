]

# Back to the default game variables
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      drawLiquid: basic-acid
      padding: 3
    }
    {
      type: DrawDefault
    }
    {
      type: DrawRegion
      suffix: -spinner
      spinSprite: true
      rotateSpeed: 2.5
    }
  ]
}

requirements: ["periodic-iron-plate/35", "copper/10", "lead/15", "periodic-copper-chunk/10", "bronze-plate/15"]
category: "crafting"
