        input: {
            items: ["periodic-zinc-ingot/12"]
            liquids: ["periodic-steam/0.1", "periodic-air-gas/0.15"]
        }
        output: {
            items: ["periodic-zinc-oxide/10"]
            liquids: []
        }
        craftTime: 600  # = 1.25 seconds
        unlocked: true
    }
    {
        name: iron-oxide1
        input: {
            items: ["periodic-iron-plate/12"]
            liquids: ["periodic-steam/0.1", "periodic-air-gas/0.15"]
        }
        output: {
            items: ["periodic-iron-oxide/10"]
            liquids: []
        }
        craftTime: 600  # = 1.25 seconds
        unlocked: true
    }
    {
        name: aluminium-oxide1
        input: {
            items: ["periodic-refined-aluminium/9"]
