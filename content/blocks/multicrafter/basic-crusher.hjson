# Mandatory, defines the block as a multicrafter
type: MultiCrafter

# You can define any block variable below, as long as it is supported by the game.
name: "Basic crusher"
description: "operates on coal to crush ore chunks into dust-like material for processing, can output by-products, quite inefficient."
size: 3
itemCapacity: 40
health: 200

# The library specific variables
jsonRecipes: [
    {
        name: crush-zinc
        input: {
            items: ["periodic-zinc-chunk/4", "coal/1"]
            liquids: []
        }
        output: {
            items: ["periodic-crushed-zinc-chunk/2", "residue/1"]
        }
        craftTime: 60  # = 1 seconds
        unlocked: true
    }
    {
        name: crush-copper
        input: {
            items: ["periodic-copper-chunk/4", "coal/1"]
            liquids: []
        }
        output: {
            items: ["periodic-crushed-copper-chunk/2", "cobalt-residue/1"]
        }
        craftTime: 90  # = 1.5 seconds
        unlocked: true
    }
    {
        name: crush-pentlandite
        input: {
            items: ["pentlandite-chunk/8", "coal/2"]
            liquids: []
        }
        output: {
            items: ["nickel-powder/6", "copper-powder/1", "cobalt-residue/1"]
        }
        craftTime: 120  # = 2 seconds
        unlocked: true
    }
    {
        name: crush-rock-salt
        input: {
            items: ["rock-salt/4", "coal/2"]
            liquids: []
        }
        output: {
            items: ["sodium-chloride/2", "stone/1", "residue/1"]
        }
        craftTime: 90  # = 1.5 seconds
        unlocked: true
    }
    {
        name: crush-chromite
        input: {
            items: ["chromite-chunk/4", "coal/2"]
            liquids: []
        }
        output: {
            items: ["concentrated-chromite/2", "crushed-iron-chunk/1", "residue/1"]
        }
        craftTime: 150  # = 2.5 seconds
        unlocked: true
    }
    {
        name: crush-aluminium
        input: {
            items: ["periodic-aluminium-chunk/6", "coal/1"]
            liquids: []
        }
        output: {
            items: ["periodic-crushed-aluminium-chunk/4", "residue/1"]
        }
        craftTime: 120  # = 1.25 seconds
        unlocked: true
    }
]

# Back to the default game variables
requirements: ["periodic-iron-plate/20", "periodic-stone/25", "periodic-copper-chunk/15"]
category: "crafting"
