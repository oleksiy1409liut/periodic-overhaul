# Mandatory, defines the block as a multicrafter
type: MultiCrafter

# You can define any block variable below, as long as it is supported by the game.
name: "Basic mixer"
description: "operates on coal to mix and separate hydrophobic and hydrophilic parts of ore chunks, honestly idk what this thing does i just read the wikipedia dont aks me shi dawg."
size: 3
itemCapacity: 40
health: 200

# The library specific variables
jsonRecipes: [
    {
        name: separate-zinc
        input: {
            items: ["periodic-crushed-zinc-chunk/4", "coal/2"]
            liquids: ["water/0.15"]
        }
        output: {
            items: ["periodic-zinc-powder/1", "sand/2"]
            liquids: [periodic-dirty-water/0.1]
        }
        craftTime: 120  # = 1 seconds
        unlocked: true
    }
    {
        name: separate-copper
        input: {
            items: ["periodic-crushed-copper-chunk/4", "coal/2"]
            liquids: ["water/0.15"]
        }
        output: {
            items: ["periodic-copper-powder/1", "sand/2"]
            liquids: [periodic-dirty-water/0.1]
        }
        craftTime: 120  # = 1.25 seconds
        unlocked: true
    }
    {
        name: separate-molybdenite-chunk
        input: {
            items: ["periodic-molybdenite-chunk/4", "coal/2"]
            liquids: ["water/0.2"]
        }
        output: {
            items: ["periodic-purified-molybdenite/2", "periodic-quartz/1", "sand/1"]
            liquids: [periodic-dirty-water/0.15]
        }
        craftTime: 160  # = 1.25 seconds
        unlocked: true
    }
]

# Back to the default game variables
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawRegion
      suffix: -spinner
    }
    {
      type: DrawLiquidTile
      drawLiquid: water
      padding: 3
    }
    {
      type: DrawDefault
    }
    {
      type: DrawRegion
      suffix: -spinner
      spinSprite: true
      rotateSpeed: 0.8
    }
  ]
}

requirements: ["periodic-iron-plate/30", "periodic-stone/10", "lead/15", "periodic-copper-chunk/10",]
category: "crafting"
