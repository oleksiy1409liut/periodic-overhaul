# Back to the default game variables
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      drawLiquid: distilled-water
      padding: 3
    }
    {
      type: DrawDefault
    }
    {
      type: DrawRegion
      suffix: -spinner
      spinSprite: true
      rotateSpeed: 2.5
    }
  ]
}

requirements: ["steel-plate/30", "refined-nickel/15", "solder-coil/3", "basic-memory-circuit/1", "refined-aluminium/15", "bronze-plate/15"]
category: "crafting"
