# Mandatory, defines the block as a multicrafter
type: MultiCrafter

# You can define any block variable below, as long as it is supported by the game.
name: "Electric Centrifuge"
description: "Can do the processes of: separating, centrifuging, washing, for separating it needs distilled water."
size: 3
itemCapacity: 30
liquidCapacity: 500
health: 375

# The library specific variables
jsonRecipes: [
