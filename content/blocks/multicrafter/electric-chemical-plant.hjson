# Mandatory, defines the block as a multicrafter
type: MultiCrafter

# You can define any block variable below, as long as it is supported by the game.
name: "Electric Chemical Plant"
description: "can do the processes of: oxidation, chemicals, cracking, crystallization."
size: 3
itemCapacity: 50
liquidCapacity: 600
health: 450
liquidOutputDirections: [1,2,3,4],

# The library specific variables
jsonRecipes: [
    {
        name: sodium-hydroxide
        input: {
            items: ["sodium-plate/1"]
            liquids: ["hydrogen/0.2", "air-gas/0.15"]
            power: 0.4
        }
        output: {
            items: ["sodium-hydroxide/2"]
            liquids: []
        }
        craftTime: 180  # = 3 seconds
        unlocked: true
    }
    {
        name: hydrogen
        input: {
            items: ["iron-plate/1"]
            liquids: ["steam/0.5"]
            power: 0.3
        }
        output: {
            items: ["iron-plate/1"]
            liquids: ["hydrogen/0.25"]
        }
        craftTime: 120  # = 2 seconds
        unlocked: true
    }
    {
        name: nitrogen-dioxide
        input: {
            items: []
            liquids: ["nitric-oxide/0.15", "air-gas/0.15"]
            power: 0.4
        }
        output: {
            items: []
            liquids: ["nitrogen-dioxide/0.3"]
        }
        craftTime: 180  # = 2 seconds
        unlocked: true
    }
    {
        name: purified-cellulose
        input: {
            items: ["wood-pulp/9", "sodium-hydroxide/4"]
            liquids: []
            power: 0.3
        }
        output: {
            items: ["purified-cellulose/4"]
            liquids: []
        }
        craftTime: 120  # = 2 seconds
        unlocked: true
    }
    {
        name: sulfuric-acid
        input: {
            items: ["sulfur-chunk/1"]
            liquids: ["nitrogen-dioxide/0.15", "water/0.2", "sulfur-dioxide/0.2"]
            power: 0.4
        }
        output: {
            items: []
            liquids: ["sulfuric-acid/0.5", "nitric-oxide/0.1"]
        }
        craftTime: 200  # = 3.333 seconds
        unlocked: true
    }
]

# Back to the default game variables
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      drawLiquid: hydrogen
      padding: 3
    }
    {
      type: DrawDefault
    }
    {
      type: DrawRegion
      suffix: -spinner
      spinSprite: true
      rotateSpeed: 3.5
    }
  ]
}

requirements: ["steel-plate/35", "copper-coil/10", "lead/20", "bronze-plate/15", "basic-memory-circuit/1", "solder-coil/2"]
category: "crafting"
