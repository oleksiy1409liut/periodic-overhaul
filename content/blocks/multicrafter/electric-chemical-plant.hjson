# Back to the default game variables
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      drawLiquid: hydrogen
      padding: 3
    }
    {
      type: DrawDefault
    }
    {
      type: DrawRegion
      suffix: -spinner
      spinSprite: true
      rotateSpeed: 3.5
    }
  ]
}

requirements: ["steel-plate/35", "copper-coil/10", "lead/20", "bronze-plate/15", "basic-memory-circuit/1", "solder-coil/2"]
