# Mandatory, defines the block as a multicrafter
type: MultiCrafter

# You can define any block variable below, as long as it is supported by the game.
name: "Electric Engraver"
description: "Engraves things onto silicon wafers to make them usable."
size: 3
itemCapacity: 40
liquidCapacity: 300
health: 650
liquidOutputDirections: [1,2,3],

# The library specific variables
jsonRecipes: [
    {
        name: silicon-wafer1
        input: {
            items: ["high-purity-silicon/2"]
            liquids: ["distilled-water/0.25"]
            power: 0.3
        }
        output: {
            items: ["silicon-wafer/4"]
        }
        craftTime: 120  # = 2.5 seconds
        unlocked: true
    }
    {
        name: N-P-wafers1
        input: {
            items: ["silicon-wafer/2", "phosphorus-powder/2"]
            liquids: ["boron/0.3"]
            power: 0.45
        }
        output: {
            items: ["N-P-wafers/2"]
            liquids: ["boron/0.3", "water/0.1", "cryofluid/0.1"]
        }
        craftTime: 60  # = 2.5 seconds
        unlocked: true
    }
        {
        name: test2
        input: {
            items: ["silicon-wafer/200", "phosphorus-powder/200"]
            liquids: ["boron/3"]
            power: 0.45
        }
        output: {
            items: ["N-P-wafers/2"]
            liquids: ["water/0.1", "cryofluid/0.1"]
        }
        craftTime: 60  # = 2.5 seconds
        unlocked: true
    }
]

# Back to the default game variables
requirements: ["steel-plate/45", "refined-aluminium/25", "solder-coil/5", "copper-coil/5", "basic-memory-circuit/1", "metaglass/15", "refined-chromium/15", "formed-lead-acid-battery/2"]
category: "crafting"
