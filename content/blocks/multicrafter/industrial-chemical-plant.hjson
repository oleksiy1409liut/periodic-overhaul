# Mandatory, defines the block as a multicrafter
type: MultiCrafter

# You can define any block variable below, as long as it is supported by the game.
name: "Industrial Chemical Plant (ICP)"
description: "Main part of the ICP multiblock that can process up to 4 different processes in one recipe, requires huge amount of power and hot air with ozone (dont ask why)."
size: 4
itemCapacity: 40
liquidCapacity: 900
health: 950
rotate: true
rotateDraw: true

# The library specific variables
jsonRecipes: [
    {
        name: high-purity-silicon
        input: {
            items: ["silicon-carbide/4"]
            liquids: ["hot-air/0.2", "ozone/0.2", "chlorine/0.1", "hydrogen/0.25"]
            power: 1.5
        }
        output: {
            items: ["high-purity-silicon/4"]
            liquids: ["air-gas/0.1"]
        }
        craftTime: 180  # = 3 seconds
        unlocked: true
    }
    {
        name: polymer-resin1
        input: {
            items: ["basic-epoxy-resin/1"]
            liquids: ["hot-air/0.2", "ozone/0.2", "sulfuric-acid/0.25", "molten-resin/0.125"]
            power: 1
        }
        output: {
            items: []
            liquids: ["polymer-resin/0.5"]
        }
        craftTime: 120  # = 3 seconds
        unlocked: true
    }
    {
        name: phosphate-mixture1
        input: {
            items: ["phosphate-chunk/4"]
            liquids: ["hot-air/0.2", "ozone/0.2", "sulfuric-acid/0.1", "distilled-water/0.2"]
            power: 0.8
        }
        output: {
            items: []
            liquids: ["phosphate-mixture/0.8"]
        }
        craftTime: 180  # = 3 seconds
        unlocked: true
    }
    {
        name: centrifuge-dirty-water
        input: {
            items: ["phosphorus-powder/1"]
            liquids: ["hot-air/0.2", "ozone/0.2", "dirty-water/5"]
            power: 0.5
        }
        output: {
            items: ["residue/2", "cobalt-residue/1", "rhenium-residue/1", "aluminium-powder/1", "cadmium-powder/1", "tin-powder/1"]
            liquids: ["water/0.4"]
        }
        craftTime: 180  # = 3 seconds
        unlocked: true
    }
    {
        name: centrifuge-residue
        input: {
            items: ["purified-cellulose/2", "residue/60"]
            liquids: ["hot-air/0.2", "ozone/0.2", "distilled-water/0.3"]
            power: 0.6
        }
        output: {
            items: ["magnesium-chloride/2", "cobalt-residue/2", "rhenium-residue/1", "zinc-residue/3", "cadmium-powder/2", "tin-powder/2", "calcium-shards/3", "silver-powder/1", "copper-residue/4"]
            liquids: ["dirty-water/0.2"]
        }
        craftTime: 240  # = 3 seconds
        unlocked: true
    }
]

# Back to the default game variables
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      drawLiquid: hydrogen
      padding: 3
    }
    {
      type: DrawDefault
    }
    {
      type: DrawRegion
      suffix: -spinner
      spinSprite: true
      rotateSpeed: 9
    }
  ]
}

requirements: ["steel-plate/90", "copper-coil/10", "lead/20", "ferrosilicon/40", "basic-memory-circuit/1", "solder-coil/6", "rhenium-rod/10"]
category: "crafting"
