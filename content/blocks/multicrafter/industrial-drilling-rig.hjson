# Mandatory, defines the block as a multicrafter
type: MultiCrafter

# You can define any block variable below, as long as it is supported by the game.
name: "Industrial Drilling Rig"
description: "Uses heavy machinery to drill deeper into the earth than other drills to extract less common resources."
size: 8
itemCapacity: 100
liquidCapacity: 600
health: 1200

drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawDefault
    }
    {
      type: DrawRegion
      suffix: -spinner
      spinSprite: true
      rotateSpeed: 1.25
    }
  ]
}

# The library specific variables
jsonRecipes: [
    {
        name: deep-mine1
        input: {
            items: ["stainless-steel-plate/1"]
            liquids: ["distilled-water/0.6"]
            power: 3.5
        }
        output: {
            items: ["residue/2", "copper-chunk/1", "molybdenite-chunk/1", "coltan-chunk/2", "clay/1"]
        }
        craftTime: 120  # = 2.5 seconds
        unlocked: true
    }
]

# Back to the default game variables
requirements: ["stainless-steel-plate/320", "printed-circuit-board/5", "solder-coil/40", "copper-coil/35", "computer-data/45", "molybdenum-plate/120]
category: "production"
