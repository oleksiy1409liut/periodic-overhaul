# Mandatory, defines the block as a multicrafter
type: MultiCrafter

# You can define any block variable below, as long as it is supported by the game.
name: "Internal Combustion Generator (ICE)"
description: "Combusts carbon fuels to generate mechanical power which is converted into electricity, also the next step in energy making after steam, not to be confused with the american deportation department."
size: 3
liquidCapacity: 600
health: 560

# The library specific variables
jsonRecipes: [
    {
        name: burn-petrol
        input: {
            liquids: ["petroleum/0.4", "hot-air/0.2"]
        }
        output: {
            power: 2
        }
        craftTime: 120  # = 1 seconds
        unlocked: true
    }
    {
        name: burn-refgas
        input: {
            liquids: ["refinery-gas/0.4", "hot-air/0.2"]
        }
        output: {
            power: 1.4
        }
        craftTime: 120  # = 1 seconds
        unlocked: true
    }
    {
        name: burn-gasoline
        input: {
            liquids: ["gasoline/0.25", "hot-air/0.1"]
        }
        output: {
            power: 2.2
        }
        craftTime: 120  # = 1 seconds
        unlocked: true
    }
]

# Back to the default game variables
requirements: ["copper-coil/5", "refined-nickel/10", "steel-plate/40", "electric-engine/4", "formed-lead-acid-battery/1"]
category: "power"
