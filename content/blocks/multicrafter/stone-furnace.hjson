# Mandatory, defines the block as a multicrafter
type: MultiCrafter

# You can define any block variable below, as long as it is supported by the game.
name: "Stone Furnace"
description: "Smelts simple materials for better uses, requires coal."
size: 2
itemCapacity: 200
health: 200

drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawGlowRegion
      suffix: -glow
      color: ffa665
      alpha: 1.2
      glowScale: 6
    }
  ]

# The library specific variables
jsonRecipes: [
    {
        name: chunk-iron-plate
        input: {
            items: ["periodic-iron-chunk/3", "coal/1"]
        }
        output: {
            items: ["periodic-iron-plate/1", "periodic-small-ash/1"]
        }
        craftTime: 120  # = 2 second
        unlocked: true
    }
    {
        name: magnetite-iron-plate
        input: {
            items: ["magnetite-chunk/3", "coal/1"]
        }
        output: {
            items: ["periodic-iron-plate/1", "small-ash/1"]
        }
        craftTime: 90  # = 1.5 second
        unlocked: true
    }
    {
        name: powder-tin-ingot
        input: {
            items: ["periodic-tin-powder/3", "coal/1"]
        }
        output: {
            items: ["periodic-tin-ingot/1", "periodic-small-ash/1"]
        }
        craftTime: 120  # = 10 seconds

        # This recipe will be unlocked and the player unlocks this research
        unlocked: true
    }
    {
        name: powder-refined-aluminium
        input: {
            items: ["periodic-aluminium-powder/3", "coal/2"]
        }
        output: {
            items: ["periodic-refined-aluminium/2", "periodic-small-ash/1"]
        }
        craftTime: 240  # = 4 seconds

        # This recipe will be unlocked and the player unlocks this research
        unlocked: true
    }
]

# Back to the default game variables
requirements: ["stone/25"]
category: "crafting"
