    }
    {
      type: DrawDefault
    }
    {
      type: DrawRegion
      suffix: -spinner
      spinSprite: true
      rotateSpeed: 5.9
    }
  ]
}

    requirements: [
        "steel-plate/15",
        "basic-epoxy-resin/5",
